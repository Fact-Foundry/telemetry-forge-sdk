@page "/"
@using FactFoundry.TelemetryForge.Desktop
@using FactFoundry.TelemetryForge.Web.Models
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Http.Resilience
@using Microsoft.Extensions.Logging
@using System.Text.Json
@using System.Reflection
@inject IHttpContextAccessor HttpContextAccessor
@implements IAsyncDisposable

<div style="max-width: 960px; margin: 0 auto; padding: 2rem;">
    <h1 style="color: #7c3aed; margin-bottom: 0.25rem;">TelemetryForge SDK Tester</h1>
    <p style="color: #666; font-size: 0.8rem; margin-bottom: 1.5rem;">SDK v@_sdkVersion</p>

    @if (!_sessionActive)
    {
        <div style="display: flex; gap: 0; margin-bottom: 1.5rem;">
            <button @onclick='() => _mode = "desktop"'
                style="flex: 1; padding: 0.75rem; border: none; cursor: pointer; font-size: 1rem; border-radius: 8px 0 0 8px;
                       background: @(_mode == "desktop" ? "#7c3aed" : "#16213e"); color: @(_mode == "desktop" ? "white" : "#aaa");">
                Desktop SDK
            </button>
            <button @onclick='() => _mode = "web"'
                style="flex: 1; padding: 0.75rem; border: none; cursor: pointer; font-size: 1rem; border-radius: 0 8px 8px 0;
                       background: @(_mode == "web" ? "#7c3aed" : "#16213e"); color: @(_mode == "web" ? "white" : "#aaa");">
                Web SDK
            </button>
        </div>

        <div style="background: #16213e; border-radius: 8px; padding: 1.5rem; margin-bottom: 1rem;">
            <h2 style="margin-bottom: 1rem; font-size: 1.1rem;">Connection</h2>
            <div style="margin-bottom: 1rem;">
                <label style="display: block; margin-bottom: 0.3rem; color: #aaa;">Server Endpoint</label>
                <input @bind="_endpoint" style="width: 100%; padding: 0.5rem; border-radius: 4px; border: 1px solid #333; background: #0f0f23; color: #eee;" />
            </div>
            <div style="margin-bottom: 1rem;">
                <label style="display: block; margin-bottom: 0.3rem; color: #aaa;">API Key</label>
                <input @bind="_apiKey" type="password" style="width: 100%; padding: 0.5rem; border-radius: 4px; border: 1px solid #333; background: #0f0f23; color: #eee;" />
            </div>

            @if (_mode == "web")
            {
                <div style="margin-bottom: 1rem;">
                    <label style="display: block; margin-bottom: 0.3rem; color: #aaa;">Client Persona</label>
                    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                        <button @onclick='() => SetPersona("human")' style="padding: 0.4rem 0.8rem; border-radius: 4px; border: none; cursor: pointer; font-size: 0.85rem; background: @(_webPersona == "human" ? "#4ade80" : "#333"); color: @(_webPersona == "human" ? "#000" : "#ccc");">
                            Human
                        </button>
                        <button @onclick='() => SetPersona("googlebot")' style="padding: 0.4rem 0.8rem; border-radius: 4px; border: none; cursor: pointer; font-size: 0.85rem; background: @(_webPersona == "googlebot" ? "#f59e0b" : "#333"); color: @(_webPersona == "googlebot" ? "#000" : "#ccc");">
                            Googlebot
                        </button>
                        <button @onclick='() => SetPersona("bingbot")' style="padding: 0.4rem 0.8rem; border-radius: 4px; border: none; cursor: pointer; font-size: 0.85rem; background: @(_webPersona == "bingbot" ? "#f59e0b" : "#333"); color: @(_webPersona == "bingbot" ? "#000" : "#ccc");">
                            Bingbot
                        </button>
                        <button @onclick='() => SetPersona("headless")' style="padding: 0.4rem 0.8rem; border-radius: 4px; border: none; cursor: pointer; font-size: 0.85rem; background: @(_webPersona == "headless" ? "#f59e0b" : "#333"); color: @(_webPersona == "headless" ? "#000" : "#ccc");">
                            Headless Chrome
                        </button>
                        <button @onclick='() => SetPersona("empty-ua")' style="padding: 0.4rem 0.8rem; border-radius: 4px; border: none; cursor: pointer; font-size: 0.85rem; background: @(_webPersona == "empty-ua" ? "#f59e0b" : "#333"); color: @(_webPersona == "empty-ua" ? "#000" : "#ccc");">
                            Empty UA
                        </button>
                    </div>
                    <p style="color: #666; font-size: 0.75rem; margin-top: 0.4rem;">Bot personas send empty Accept-Language and no referrer — triggers server-side bot detection.</p>
                </div>
            }

            <button @onclick="StartSession" style="background: #7c3aed; color: white; border: none; padding: 0.7rem 2rem; border-radius: 4px; cursor: pointer; font-size: 1rem;">
                Start Session
            </button>
        </div>
    }
    else if (_mode == "desktop")
    {
        @* ── Desktop Mode ── *@
        <div style="background: #16213e; border-radius: 8px; padding: 1rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
            <span style="color: #4ade80;">● Desktop Session Active</span>
            <span style="color: #aaa;">@_eventLog.Count(e => e.StartsWith("[") && e.Contains("Feature:")) features tracked</span>
            <button @onclick="StopDesktopSession" style="background: #dc2626; color: white; border: none; padding: 0.5rem 1.5rem; border-radius: 4px; cursor: pointer;">
                Stop &amp; Flush
            </button>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
            <div style="background: #16213e; border-radius: 8px; padding: 1.5rem;">
                <h3 style="margin-bottom: 1rem; color: #7c3aed;">Navigation</h3>
                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                    <button @onclick='() => TrackFeature("Dashboard")' class="feature-btn">Dashboard</button>
                    <button @onclick='() => TrackFeature("Editor")' class="feature-btn">Editor</button>
                    <button @onclick='() => TrackFeature("Settings")' class="feature-btn">Settings</button>
                    <button @onclick='() => TrackFeature("Reports")' class="feature-btn">Reports</button>
                    <button @onclick='() => TrackFeature("UserProfile")' class="feature-btn">User Profile</button>
                </div>
            </div>

            <div style="background: #16213e; border-radius: 8px; padding: 1.5rem;">
                <h3 style="margin-bottom: 1rem; color: #7c3aed;">Actions</h3>
                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                    <button @onclick='() => TrackFeature("Export")' class="feature-btn">Export Data</button>
                    <button @onclick='() => TrackFeature("Import")' class="feature-btn">Import File</button>
                    <button @onclick='() => TrackFeature("Search")' class="feature-btn">Search</button>
                    <button @onclick="SimulateError" style="background: #dc2626; color: white; border: none; padding: 0.5rem 1rem; border-radius: 4px; cursor: pointer;">
                        Simulate Error
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        @* ── Web Mode ── *@
        <div style="background: #16213e; border-radius: 8px; padding: 1rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
            <span style="color: #4ade80;">● Web Session Active</span>
            <span style="color: #aaa;">@_webPagePath.Count pages visited</span>
            <button @onclick="StopWebSession" style="background: #dc2626; color: white; border: none; padding: 0.5rem 1.5rem; border-radius: 4px; cursor: pointer;">
                End Session &amp; Flush
            </button>
        </div>

        <div style="background: #16213e; border-radius: 8px; padding: 1.5rem; margin-bottom: 1.5rem;">
            <h3 style="margin-bottom: 1rem; color: #7c3aed;">Simulate Page Navigation</h3>
            <p style="color: #888; margin-bottom: 1rem; font-size: 0.9rem;">Click pages to simulate a user browsing your site. Each click adds to the page path.</p>
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem;">
                <button @onclick='() => WebNavigate("/")' class="feature-btn">/  (Home)</button>
                <button @onclick='() => WebNavigate("/features")' class="feature-btn">/features</button>
                <button @onclick='() => WebNavigate("/pricing")' class="feature-btn">/pricing</button>
                <button @onclick='() => WebNavigate("/docs")' class="feature-btn">/docs</button>
                <button @onclick='() => WebNavigate("/docs/getting-started")' class="feature-btn">/docs/getting-started</button>
                <button @onclick='() => WebNavigate("/docs/api-reference")' class="feature-btn">/docs/api-reference</button>
                <button @onclick='() => WebNavigate("/blog")' class="feature-btn">/blog</button>
                <button @onclick='() => WebNavigate("/about")' class="feature-btn">/about</button>
                <button @onclick='() => WebNavigate("/contact")' class="feature-btn">/contact</button>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
            <div style="background: #16213e; border-radius: 8px; padding: 1.5rem;">
                <h3 style="margin-bottom: 1rem; color: #7c3aed;">Session Headers</h3>
                <div style="font-family: monospace; font-size: 0.85rem; color: #aaa; display: flex; flex-direction: column; gap: 0.4rem;">
                    <div><span style="color: #7c3aed;">Referrer:</span> @(_webReferrer ?? "(direct)")</div>
                    <div><span style="color: #7c3aed;">User-Agent:</span> <span style="word-break: break-all;">@_webUserAgent</span></div>
                    <div><span style="color: #7c3aed;">Language:</span> @_webLanguage</div>
                    <div><span style="color: #7c3aed;">Sec-CH-UA:</span> <span style="word-break: break-all;">@(_webSecChUa ?? "(none)")</span></div>
                    <div><span style="color: #7c3aed;">Sec-CH-UA-Mobile:</span> @(_webSecChUaMobile ?? "(none)")</div>
                    <div><span style="color: #7c3aed;">Sec-CH-UA-Platform:</span> @(_webSecChUaPlatform ?? "(none)")</div>
                    <div><span style="color: #7c3aed;">IP:</span> @_webIp</div>
                </div>
            </div>

            <div style="background: #16213e; border-radius: 8px; padding: 1.5rem;">
                <h3 style="margin-bottom: 1rem; color: #7c3aed;">Session Stats</h3>
                <div style="font-family: monospace; font-size: 0.85rem; color: #aaa; display: flex; flex-direction: column; gap: 0.4rem;">
                    <div><span style="color: #7c3aed;">Started:</span> @_webSessionStart.ToLocalTime().ToString("HH:mm:ss")</div>
                    <div><span style="color: #7c3aed;">Duration:</span> @((int)(DateTimeOffset.UtcNow - _webSessionStart).TotalSeconds)s</div>
                    <div><span style="color: #7c3aed;">Entry Page:</span> @(_webPagePath.Count > 0 ? _webPagePath[0] : "—")</div>
                    <div><span style="color: #7c3aed;">Current Page:</span> @(_webPagePath.Count > 0 ? _webPagePath[^1] : "—")</div>
                    <div><span style="color: #7c3aed;">Pages:</span> @_webPagePath.Count</div>
                </div>
            </div>
        </div>

        <div style="background: #16213e; border-radius: 8px; padding: 1.5rem; margin-bottom: 1.5rem;">
            <h3 style="margin-bottom: 1rem; color: #7c3aed;">Breadcrumb Trail</h3>
            <div style="display: flex; flex-wrap: wrap; gap: 0.3rem; align-items: center; font-family: monospace; font-size: 0.85rem;">
                @for (var i = 0; i < _webPagePath.Count; i++)
                {
                    if (i > 0)
                    {
                        <span style="color: #555;">&rarr;</span>
                    }
                    <span style="background: #0f3460; padding: 0.2rem 0.5rem; border-radius: 3px; color: #eee;">@_webPagePath[i]</span>
                }
            </div>
        </div>

        @if (_webPayloadJson is not null)
        {
            <div style="background: #16213e; border-radius: 8px; padding: 1.5rem; margin-bottom: 1.5rem;">
                <h3 style="margin-bottom: 1rem; color: #4ade80;">Payload Sent to Server</h3>
                <pre style="background: #0f0f23; padding: 1rem; border-radius: 4px; overflow-x: auto; font-size: 0.85rem; color: #eee; white-space: pre-wrap;">@_webPayloadJson</pre>
            </div>
        }
    }

    @* ── Event Log (shared) ── *@
    @if (_eventLog.Count > 0)
    {
        <div style="background: #16213e; border-radius: 8px; padding: 1.5rem;">
            <h3 style="margin-bottom: 1rem; color: #7c3aed;">Event Log</h3>
            <div style="max-height: 200px; overflow-y: auto; font-family: monospace; font-size: 0.85rem; color: #aaa;">
                @foreach (var entry in _eventLog.AsEnumerable().Reverse())
                {
                    <div style="padding: 0.2rem 0; border-bottom: 1px solid #222;">@entry</div>
                }
            </div>
        </div>
    }
</div>

<style>
    .feature-btn {
        background: #0f3460;
        color: #eee;
        border: 1px solid #1a4a7a;
        padding: 0.5rem 1rem;
        border-radius: 4px;
        cursor: pointer;
        text-align: left;
    }
    .feature-btn:hover {
        background: #1a4a7a;
    }
</style>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new() { WriteIndented = true };

    private readonly string _sdkVersion = typeof(WebEventPayload).Assembly
        .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion
        ?? typeof(WebEventPayload).Assembly.GetName().Version?.ToString()
        ?? "unknown";

    private string _mode = "desktop";
    private string _endpoint = "http://localhost:5090";
    private string _apiKey = "";
    private bool _sessionActive;
    private readonly List<string> _eventLog = [];

    // ── Desktop state ──
    private ServiceProvider? _serviceProvider;
    private DesktopSessionTracker? _tracker;

    // ── Web state ──
    private ITelemetryClient? _webClient;
    private ServiceProvider? _webServiceProvider;
    private DateTimeOffset _webSessionStart;
    private readonly List<string> _webPagePath = [];
    private string _webUserAgent = string.Empty;
    private string? _webReferrer;
    private string _webLanguage = string.Empty;
    private string _webIp = string.Empty;
    private string? _webSecChUa;
    private string? _webSecChUaMobile;
    private string? _webSecChUaPlatform;
    private string _realUserAgent = string.Empty;
    private string? _realReferrer;
    private string _realLanguage = string.Empty;
    private string? _realSecChUa;
    private string? _realSecChUaMobile;
    private string? _realSecChUaPlatform;
    private string _webSessionId = string.Empty;
    private string? _webPayloadJson;
    private string _webPersona = "human";

    protected override void OnInitialized()
    {
        var context = HttpContextAccessor.HttpContext;
        if (context is not null)
        {
            _realUserAgent = _webUserAgent = context.Request.Headers.UserAgent.ToString();
            _realReferrer = _webReferrer = context.Request.Headers.Referer.ToString() is { Length: > 0 } r ? r : null;
            _realLanguage = _webLanguage = context.Request.Headers.AcceptLanguage.ToString();
            _realSecChUa = _webSecChUa = context.Request.Headers["Sec-CH-UA"].ToString() is { Length: > 0 } ch ? ch : null;
            _realSecChUaMobile = _webSecChUaMobile = context.Request.Headers["Sec-CH-UA-Mobile"].ToString() is { Length: > 0 } chm ? chm : null;
            _realSecChUaPlatform = _webSecChUaPlatform = context.Request.Headers["Sec-CH-UA-Platform"].ToString() is { Length: > 0 } chp ? chp : null;

            var forwarded = context.Request.Headers["X-Forwarded-For"].ToString();
            if (!string.IsNullOrEmpty(forwarded))
                _webIp = forwarded.Split(',', StringSplitOptions.TrimEntries)[0];
            else
                _webIp = context.Connection.RemoteIpAddress?.ToString() ?? "unknown";
        }
    }

    private void SetPersona(string persona)
    {
        _webPersona = persona;
        switch (persona)
        {
            case "googlebot":
                _webUserAgent = "Mozilla/5.0 (compatible; Googlebot/2.1; +http://www.google.com/bot.html)";
                _webLanguage = "";
                _webReferrer = null;
                _webSecChUa = null;
                _webSecChUaMobile = null;
                _webSecChUaPlatform = null;
                break;
            case "bingbot":
                _webUserAgent = "Mozilla/5.0 (compatible; bingbot/2.0; +http://www.bing.com/bingbot.htm)";
                _webLanguage = "";
                _webReferrer = null;
                _webSecChUa = null;
                _webSecChUaMobile = null;
                _webSecChUaPlatform = null;
                break;
            case "headless":
                _webUserAgent = "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/130.0.0.0 Safari/537.36";
                _webLanguage = "";
                _webReferrer = null;
                _webSecChUa = null;
                _webSecChUaMobile = null;
                _webSecChUaPlatform = null;
                break;
            case "empty-ua":
                _webUserAgent = "";
                _webLanguage = "";
                _webReferrer = null;
                _webSecChUa = null;
                _webSecChUaMobile = null;
                _webSecChUaPlatform = null;
                break;
            default:
                _webUserAgent = _realUserAgent;
                _webLanguage = _realLanguage;
                _webReferrer = _realReferrer;
                _webSecChUa = _realSecChUa;
                _webSecChUaMobile = _realSecChUaMobile;
                _webSecChUaPlatform = _realSecChUaPlatform;
                break;
        }
    }

    private void StartSession()
    {
        if (string.IsNullOrWhiteSpace(_endpoint) || string.IsNullOrWhiteSpace(_apiKey))
            return;

        _eventLog.Clear();

        if (_mode == "desktop")
            StartDesktopSession();
        else
            StartWebSession();

        _sessionActive = true;
    }

    // ── Desktop ──

    private void StartDesktopSession()
    {
        var services = new ServiceCollection();
        services.AddLogging(b => b.AddConsole().SetMinimumLevel(LogLevel.Debug));
        services.AddLogging(b => b.AddProvider(new EventLogLoggerProvider(_eventLog, () => InvokeAsync(StateHasChanged))));
        services.AddTelemetryForge(options =>
        {
            options.Endpoint = _endpoint;
            options.ApiKey = _apiKey;
            options.AppVersion = "1.0.0-testapp";
        });

        _serviceProvider = services.BuildServiceProvider();
        _tracker = _serviceProvider.GetRequiredService<DesktopSessionTracker>();
        Log("Desktop session started");
    }

    private async Task StopDesktopSession()
    {
        if (_tracker is not null)
        {
            try
            {
                await _tracker.FlushAsync();
                Log("Desktop session flushed to server");
            }
            catch (Exception ex)
            {
                Log($"Flush error: {ex.Message}");
            }
        }

        if (_serviceProvider is not null)
        {
            await _serviceProvider.DisposeAsync();
            _serviceProvider = null;
        }

        _tracker = null;
        _sessionActive = false;
    }

    private void TrackFeature(string feature)
    {
        _tracker?.TrackFeature(feature);
        Log($"Feature: {feature}");
    }

    private void SimulateError()
    {
        _tracker?.TrackError("Reports", "Simulated: Data source unavailable");
        Log("Error: Reports — Data source unavailable");
    }

    // ── Web ──

    private void StartWebSession()
    {
        var services = new ServiceCollection();
        services.AddLogging(b => b.AddConsole().SetMinimumLevel(LogLevel.Debug));
        services.AddLogging(b => b.AddProvider(new EventLogLoggerProvider(_eventLog, () => InvokeAsync(StateHasChanged))));
        services.AddHttpClient<ITelemetryClient, TelemetryForgeHttpClient>(client =>
        {
            client.BaseAddress = new Uri(_endpoint.TrimEnd('/'));
            client.DefaultRequestHeaders.Add("X-TelemetryForge-Key", _apiKey);
        })
        .AddStandardResilienceHandler();

        _webServiceProvider = services.BuildServiceProvider();
        _webClient = _webServiceProvider.GetRequiredService<ITelemetryClient>();
        _webSessionStart = DateTimeOffset.UtcNow;
        _webSessionId = Guid.NewGuid().ToString();
        _webPagePath.Clear();
        _webPayloadJson = null;

        Log("Web session started — click pages to simulate browsing");
    }

    private async Task WebNavigate(string path)
    {
        _webPagePath.Add(path);
        Log($"Navigated to {path}");

        if (_webClient is not null)
        {
            var payload = new WebEventPayload
            {
                SessionId = _webSessionId,
                EventType = "page_view",
                Platform = "blazor-server",
                Timestamp = DateTimeOffset.UtcNow,
                IpAddress = _webIp,
                UserAgent = _webUserAgent,
                Referrer = _webReferrer,
                Language = _webLanguage,
                SecChUa = _webSecChUa,
                SecChUaMobile = _webSecChUaMobile,
                SecChUaPlatform = _webSecChUaPlatform,
                PagePath = path,
                StatusCode = 200
            };

            try
            {
                await _webClient.SendAsync("/api/telemetry/web", payload);
                Log($"page_view event sent for {path}");
            }
            catch (Exception ex)
            {
                Log($"Event send error: {ex.Message}");
            }
        }
    }

    private async Task StopWebSession()
    {
        if (_webClient is null || _webPagePath.Count == 0)
        {
            Log("No pages visited — nothing to send");
            _sessionActive = false;
            return;
        }

        var lastPage = _webPagePath[^1];
        var payload = new WebEventPayload
        {
            SessionId = _webSessionId,
            EventType = "circuit_close",
            Platform = "blazor-server",
            Timestamp = DateTimeOffset.UtcNow,
            IpAddress = _webIp,
            UserAgent = _webUserAgent,
            Referrer = _webReferrer,
            Language = _webLanguage,
            SecChUa = _webSecChUa,
            SecChUaMobile = _webSecChUaMobile,
            SecChUaPlatform = _webSecChUaPlatform,
            PagePath = lastPage
        };

        _webPayloadJson = JsonSerializer.Serialize(payload, JsonOptions);
        Log("Circuit close event built — sending to server...");

        try
        {
            await _webClient.SendAsync("/api/telemetry/web", payload);
            Log("Circuit close event sent to server");
        }
        catch (Exception ex)
        {
            Log($"Flush error: {ex.Message}");
        }

        if (_webServiceProvider is not null)
        {
            await _webServiceProvider.DisposeAsync();
            _webServiceProvider = null;
        }

        _webClient = null;
    }

    // ── Shared ──

    private void Log(string message)
    {
        _eventLog.Add($"[{DateTime.Now:HH:mm:ss}] {message}");
    }

    public async ValueTask DisposeAsync()
    {
        if (_tracker is not null)
            await _tracker.FlushAsync();
        if (_serviceProvider is not null)
            await _serviceProvider.DisposeAsync();
        if (_webServiceProvider is not null)
            await _webServiceProvider.DisposeAsync();
    }

    private sealed class EventLogLoggerProvider(List<string> log, Func<Task> onLog) : ILoggerProvider
    {
        public ILogger CreateLogger(string categoryName) => new EventLogLogger(log, categoryName, onLog);
        public void Dispose() { }
    }

    private sealed class EventLogLogger(List<string> log, string category, Func<Task> onLog) : ILogger
    {
        public IDisposable? BeginScope<TState>(TState state) where TState : notnull => null;
        public bool IsEnabled(LogLevel logLevel) => logLevel >= LogLevel.Warning;
        public void Log<TState>(LogLevel logLevel, EventId eventId, TState state, Exception? exception, Func<TState, Exception?, string> formatter)
        {
            var shortCategory = category.Contains('.') ? category[(category.LastIndexOf('.') + 1)..] : category;
            log.Add($"[{DateTime.Now:HH:mm:ss}] [{logLevel}] {shortCategory}: {formatter(state, exception)}");
            _ = onLog();
        }
    }
}
